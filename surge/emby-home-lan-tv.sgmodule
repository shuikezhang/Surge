#!name=Emby Home LAN - Apple TV Only
#!desc=Home gateway only. Keep above Emby Proxy and other cole.best modules. Routes only emby.cole.best to SHUI wired LAN HTTPS; no MITM, no public DNS or subscription changes. Disable to restore the previous route. Do not install on travel devices.
#!requirement=SYSTEM == 'tvOS'

[General]
use-local-host-item-for-proxy = true
always-real-ip = %APPEND% emby.cole.best

[Host]
emby.cole.best = 192.168.1.3

[Rule]
DOMAIN,emby.cole.best,DIRECT
