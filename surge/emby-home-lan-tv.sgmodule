#!name=Emby Home LAN - Apple TV Only
#!desc=Install on iOS to sync to Apple TV. All settings apply only on tvOS; iOS is a transport only. Enable on the home ATV and keep above Emby Proxy/cole.best modules. No MITM or public DNS changes. Disable on ATV to restore the previous route.
#!requirement=CORE_VERSION>=22 && (SYSTEM == 'iOS' || SYSTEM == 'tvOS')

[General]
#!REQUIREMENT SYSTEM=='tvOS' use-local-host-item-for-proxy = true
#!REQUIREMENT SYSTEM=='tvOS' always-real-ip = %APPEND% emby.cole.best

[Host]
#!REQUIREMENT SYSTEM=='tvOS' emby.cole.best = 192.168.1.3

[Rule]
#!REQUIREMENT SYSTEM=='tvOS' DOMAIN,emby.cole.best,DIRECT
