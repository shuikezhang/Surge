#!name=微博去广告 (Surge)
#!desc=针对微博国际版及官方版客户端去广告：精准拦截第三方广告联盟SDK（腾讯优量汇、快手联盟、优盟等）、拦截微博开屏决策与数据收集、Mock空决策避免启动等待与异常重试。基于真机HAR抓包逆向分析。
#!author=Minis
#!category=去广告专用
#!requirement=CORE_VERSION>=20

[Rule]
# === 1. 抓包确认的第三方广告联盟 SDK ===
# 腾讯广告 / 优量汇 (GDT SDK)
DOMAIN,mi.gdt.qq.com,REJECT
DOMAIN,v2mi.gdt.qq.com,REJECT
DOMAIN,v3.gdt.qq.com,REJECT
DOMAIN,win.gdt.qq.com,REJECT
DOMAIN,qzs.gdtimg.com,REJECT
DOMAIN,pgdt.gtimg.cn,REJECT
DOMAIN,pgdt.ugdtimg.com,REJECT
DOMAIN,sdk.e.qq.com,REJECT
DOMAIN,sdkquic.e.qq.com,REJECT

# 快手联盟广告 SDK
DOMAIN,open.e.kuaishou.com,REJECT
DOMAIN,p66-ad.adkwai.com,REJECT

# 聚合广告 / 推广 SDK
DOMAIN,api.touch-moblie.com,REJECT
DOMAIN,fapi.xdrun.com,REJECT
DOMAIN,yumao.puata.info,REJECT

# 友盟统计与追踪 SDK
DOMAIN,cnlogs.umengcloud.com,REJECT
DOMAIN,oslogs.umeng.com,REJECT
DOMAIN,resolve.umeng.com,REJECT
DOMAIN,utoken.umeng.com,REJECT
DOMAIN,ucc.umeng.com,REJECT

# === 2. 微博官方广告与开屏上报链路 ===
# 微博开屏预加载与商业化策略
DOMAIN,bootpreload.uve.weibo.com,REJECT
DOMAIN,adstrategy.biz.weibo.com,REJECT
DOMAIN,vs.biz.weibo.com,REJECT

# 微博数据收集与上报接口 (URL-REGEX 精准匹配，不影响业务API)
URL-REGEX,^https?://tqt\.weibo\.cn/data/collect\.php,REJECT

[Script]
# 开屏决策接口与广告配置 Mock，返回空广告物料与空策略，消除启动白屏与反复重试
weibo-launch-mock = type=http-request,pattern=^https?://tqt\.weibo\.cn/(?:api/fortune/decisionMaker/|sdk/v3/conf),script-path=https://fastly.jsdelivr.net/gh/shuikezhang/Surge@6dfdee8558fab4d6ee1ebf6ad03c5ed3abb6253d/surge/%E5%8E%BB%E5%B9%BF%E5%91%8A%E4%B8%93%E7%94%A8/scripts/weibo-mock.js,engine=jsc,script-update-interval=86400

[MITM]
hostname = %APPEND% tqt.weibo.cn
